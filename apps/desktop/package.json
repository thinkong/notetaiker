{
  "name": "@notetaiker/desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun --watch src/api/index.ts\" \"vite\"",
    "dev:desktop": "vite build && bunx electrobun dev",
    "build": "tsc -b && vite build",
    "build:desktop": "vite build && bunx electrobun build",
    "build:desktop:stable": "vite build && bunx electrobun build --env=stable",
    "build:desktop:all": "vite build && bunx electrobun build --targets macos-arm64,win-x64,linux-x64",
    "test": "vitest",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.29",
