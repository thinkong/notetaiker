{
  "name": "notetaiker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --filter '*' build",
    "dev": "bun --filter @notetaiker/desktop dev",
    "lint": "bun --filter '*' lint",
    "lint:fix": "bun --filter '*' lint -- --fix",
    "desktop:dev": "bun --filter @notetaiker/desktop dev:desktop",
    "desktop:build": "bun --filter @notetaiker/desktop build:desktop",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "0.3.0"
}
