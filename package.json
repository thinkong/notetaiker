{
  "name": "notetaiker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel --ui tui --filter=@notetaiker/web --filter=@notetaiker/api",
    "ollama:start": "docker compose up -d ollama",
    "ollama:stop": "docker compose down ollama",
    "docker:start": "docker compose up --build -d",
    "docker:stop": "docker compose down",
    "docker:build": "docker compose build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint --parallel -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.3"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}